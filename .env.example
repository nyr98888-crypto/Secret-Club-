# Database (Neon Postgres). If unset, local .data/store.json is used.
DATABASE_URL=

# Pepper for HMAC passcode hashing
PASSCODE_PEPPER=change-me-to-a-long-random-string

# Session / entitlement cookie signing
AUTH_SECRET=change-me-to-another-long-random-string

# HMAC VIP license keys / proof tokens (falls back to AUTH_SECRET if unset)
LICENSE_SIGNING_SECRET=change-me-to-a-dedicated-license-hmac-secret
LICENSE_SECRET=

# Optional Lemon Squeezy license validation
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown in Parent Guarantee checkout UI (must match Stripe / Lemon price)
NEXT_PUBLIC_VIP_PRICE_LABEL=$4.99
NEXT_PUBLIC_LEMON_CHECKOUT_URL=

# Optional: Vercel Blob for photo uploads (falls back to data URLs)
BLOB_READ_WRITE_TOKEN=

# Stripe VIP Club Key ($4.99 one-time)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VIP=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
